{% include portfolio_flags.liquid %}
{% if portfolio_ui %}
  {% capture footer_contents %}
    &copy; {{ site.time | date: '%Y' }}
    {{ site.first_name }}
    {{ site.last_name }}
  {% endcapture %}
{% else %}
  {% capture footer_contents %}
    &copy; Copyright {{ site.time | date: '%Y' }}
    {{ site.first_name }}
    {{ site.middle_name }}
    {{ site.last_name }}. {{ site.footer_text }}
    {% if site.impressum_path %}
      <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
    {% endif %}
    {% if site.last_updated %}
      Last updated: {{ 'now' | date: '%B %d, %Y' }}.
    {% endif %}
  {% endcapture %}
{% endif %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom{% if portfolio_ui %} portfolio-footer{% endif %}" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5{% if portfolio_ui %} portfolio-footer{% endif %}" role="contentinfo">
    {% if site.newsletter.enabled and portfolio_ui != true %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
